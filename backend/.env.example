# =============================================================================
# PitWall Intelligence — Environment Configuration
#
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# .env is gitignored — NEVER commit secrets to version control.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="PitWall Intelligence"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set CORS_ALLOW_ALL=true for local development (allows all origins).
# In production: set CORS_ALLOW_ALL=false and list specific origins.
CORS_ALLOW_ALL=true

# ─── Compute / Hardware ───────────────────────────────────────────────────────
# Options: auto | cuda | cpu
# 'auto' detects CUDA and falls back to CPU automatically.
# For an 8 GB RAM machine without a capable GPU, leave as 'auto' or set 'cpu'.
DEVICE=auto

# Model weight dtype.
# 'float32' is the ONLY safe choice on CPU (float16 is slow on CPU).
# On CUDA GPU with enough VRAM, 'float16' halves memory usage.
TORCH_DTYPE=float32

# RAM budget for model weights (GB).
# Leave ~2-3 GB headroom for OS + browser + Python overhead.
# On 8 GB machine: 5.0 is safe. On 16 GB: 10.0 is fine.
MAX_RAM_GB=5.0

# ─── HuggingFace ──────────────────────────────────────────────────────────────
# Your HuggingFace API token. Get one at: https://huggingface.co/settings/tokens
# Required for: VLM explanations via HF Inference API.
# Optional if you skip VLM or run purely locally.
HF_TOKEN=

# Local directory for downloaded model weights.
# Models are large (1-15 GB) — point this to a drive with enough space.
HF_CACHE_DIR=.hf_cache

# Force ALL models to use HF Inference API (for very constrained machines).
# Requires HF_TOKEN. Set true only if local inference is too slow.
USE_HF_INFERENCE_API=false

# ─── Model IDs ────────────────────────────────────────────────────────────────
# Only change these if you want to experiment with different models.
# The defaults are tuned for 8 GB RAM / CPU-first development.
DINOV2_MODEL_ID=facebook/dinov2-base
SEGFORMER_MODEL_ID=nvidia/segformer-b2-finetuned-cityscapes-1024-1024
CLIP_MODEL_ID=openai/clip-vit-large-patch14
VLM_MODEL_ID=Qwen/Qwen2-VL-7B-Instruct

# ─── VLM (Natural Language Explanations) ─────────────────────────────────────
# The VLM generates engineer-style explanations.
# If unavailable (no token, no GPU), the system falls back to structured text.
# The structured fallback is perfectly usable — the system never breaks.

# Enable VLM explanations (true/false).
VLM_ENABLED=true

# Where to run the VLM:
#   api   — HuggingFace Inference API (recommended; requires HF_TOKEN)
#   local — Self-hosted (requires ≥16 GB VRAM — NOT viable on 8 GB machines)
#   none  — Always use structured fallback
VLM_PROVIDER=api

# Timeout for VLM API calls (seconds). Falls back to structured template if exceeded.
VLM_API_TIMEOUT_SECONDS=25

# Cache VLM responses to reduce API calls (recommended).
VLM_CACHE_ENABLED=true
VLM_CACHE_SIZE=64

# ─── Weather Integration (optional) ───────────────────────────────────────────
# The system works perfectly offline without weather data.
# Enable only if you have an OpenWeatherMap API key.
WEATHER_ENABLED=false
WEATHER_API_KEY=

# ─── Session Store ────────────────────────────────────────────────────────────
# How long to keep session analysis history in memory.
SESSION_TTL_SECONDS=7200
SESSION_MAX_FRAMES=200
SESSION_MAX_CONCURRENT=10

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500

# ─── Inference Pipeline ───────────────────────────────────────────────────────
# Frame rate for video analysis (frames per second to extract).
# 1.0 fps is ideal for track condition analysis (conditions change slowly).
VIDEO_ANALYSIS_FPS=1.0
VIDEO_MAX_FRAMES=120
TEMPORAL_WINDOW_SIZE=8
MIN_FRAMES_FOR_TREND=3

# ─── Demo Mode ────────────────────────────────────────────────────────────────
DEMO_MODE_ENABLED=true
DEMO_CLIPS_DIR=demo_clips

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
